{
  "rules": {
    ".read": false,
    ".write": false,
    "parties": {
      "$code": {
        ".read": true,
        ".write": "$code.matches(/^[0-9]{5}$/)"
      }
    },
    "searchCache": {
      "$key": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren(['t'])"
      }
    },
    "quota": {
      "exhaustedDay": {
        ".read": true,
        ".write": true,
        ".validate": "newData.isString() && newData.val().length <= 10"
      }
    },
    "library": {
      ".read": true,
      "$videoId": {
        ".write": true,
        ".validate": "$videoId.matches(/^[A-Za-z0-9_-]{11}$/) && newData.hasChildren(['videoId','title'])"
      }
    }
  }
}
